  reload: 2
  sprite: {fileID: 2995792322056023223, guid: 44ffd0a0e3d0dfd43afa94e7a23effad, type: 3}
  cost: 500
  updated: []
  staticMode: 0
  specialBullet: {fileID: 8142948613995204525, guid: 6479f0985dee3784c97eebb37594e304, type: 3}
  title:
  - "\u0406\u043D\u0444\u0435\u0440\u043D\u043E"
  - Inferno
  - "\u0418\u043D\u0444\u0435\u0440\u043D\u043E"
  descr:
  - "\u0410 \u043E\u0441\u044C \u0446\u044E \u0432\u0435\u0436\u0443 \u0441\u0442\u0432\u043E\u0440\u0438\u0432
    \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439 \u0441\u0430\u0442\u0430\u043D\u0456\u0441\u0442!
    \u0410\u043B\u0435 \u0432\u0438 \u043B\u0438\u0448\u0435 \u043F\u043E\u0434\u0438\u0432\u0456\u0442\u044C\u0441\u044F
    \u0457\u0457 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438!\r\n\r\n{0}\r\n\r\n\u041F\u0440\u0438\u043C\u0456\u0442\u043A\u0430:
    \u0417\u0430\u043F\u0443\u0441\u043A\u0430\u0454 \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043D\u0438\u0439
    \u0441\u043D\u0430\u0440\u044F\u0434 \u0443 \u0432\u0438\u0431\u0440\u0430\u043D\u043E\u043C\u0443
    \u043D\u0430\u043F\u0440\u044F\u043C\u043A\u0443. \u041C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043D\u0438\u0439
    \u0441\u043D\u0430\u0440\u044F\u0434 \u0437\u0430\u0432\u0434\u0430\u0454 \u0432
    5 \u0440\u0430\u0437\u0456\u0432 \u0431\u0456\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0443
    \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u043C \u0437\u043E\u043C\u0431\u0456
    \u0456 \u0432 2,5 \u0440\u0430\u0437\u0438 \u0431\u0456\u043B\u044C\u0448\u0435
    \u0443\u0440\u043E\u043D\u0443 \u043D\u0435\u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u043C
    \u0437\u043E\u043C\u0431\u0456."
  - 'This tower was built by a true Satanist! Just look at its stats!



    {0}



    Note:
    Fires a meteorite projectile in the target direction. The meteorite deals 5x
    damage to armored zombies and 2.5x damage to unarmored zombies.'
  - "\u0410 \u0432\u043E\u0442 \u044D\u0442\u0443 \u0431\u0430\u0448\u043D\u044E
    \u0441\u043E\u0437\u0434\u0430\u043B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
    \u0441\u0430\u0442\u0430\u043D\u0438\u0441\u0442... \u0418 \u044D\u0442\u043E
    \u0432\u0441\u0451 \u0435\u0449\u0451 \u043D\u0435 \u0432\u0440\u0430\u0442\u0430
    \u0432 \u0410\u0434, \u0430 \u0432\u0441\u0435\u0433\u043E-\u0442\u043E \u043F\u0435\u043D\u0442\u0430\u0433\u0440\u0430\u043C\u043C\u0430
    \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F.\r\n\r\n{0}\r\n\r\n\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u043D\u0438\u0435:
    \u0417\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043D\u044B\u0439
    \u0441\u043D\u0430\u0440\u044F\u0434 \u0432 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438. \u041C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043D\u044B\u0439
    \u0441\u043D\u0430\u0440\u044F\u0434 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
    \u0432 5 \u0440\u0430\u0437 \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430
    \u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C
    \u0437\u043E\u043C\u0431\u0438 \u0438 \u0432 2,5 \u0440\u0430\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
    \u0443\u0440\u043E\u043D\u0430 \u043D\u0435\u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C
    \u0437\u043E\u043C\u0431\u0438."
