  m_Script: {fileID: 11500000, guid: 7dca7589529a8e54fa7bef65f0bf6392, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UIHintController
  hoverShow: []
  clickShow: []
  rewriteRotation: 0
  hint: {fileID: 3308186051755512878, guid: deaccf6588755764989cbd8efab72b7f, type: 3}
  hintText:
  - "\u041F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u043D\u044F \u043F\u0440\u043E\u043C\u0438\u0441\u043B\u043E\u0432\u043E\u0433\u043E
    \u0441\u0435\u043A\u0442\u043E\u0440\u0430:\r\n1 \u0440\u0456\u0432\u0435\u043D\u044C:
    \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044C \u043B\u0438\u0448\u0435 -5%.\r\n2
    \u0440\u0456\u0432\u0435\u043D\u044C: \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044C
    \u043B\u0438\u0448\u0435 -10%.\r\n3 \u0440\u0456\u0432\u0435\u043D\u044C: \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044C
    \u0432\u0441\u044C\u043E\u0433\u043E \u201315%.\r\n4 \u0440\u0456\u0432\u0435\u043D\u044C
    \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044C \u0432\u0441\u044C\u043E\u0433\u043E
    -20%.\r\n5 \u0440\u0456\u0432\u0435\u043D\u044C: \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044C
    -25%."
  - 'Industrial Sector Improvements:

    Level 1: Total Cost -5%.

    Level 2:
    Total Cost -10%.

    Level 3: Total Cost -15%.

    Level 4: Total Cost -20%.

    Level
    5: Total Cost -25%.'
  - "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0433\u043E
    \u0441\u0435\u043A\u0442\u043E\u0440\u0430:\r\n1 \u0443\u0440\u043E\u0432\u0435\u043D\u044C:
    \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0432\u0441\u0435\u0433\u043E
    \u20135%.\r\n2 \u0443\u0440\u043E\u0432\u0435\u043D\u044C: \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
    \u0432\u0441\u0435\u0433\u043E \u201310%.\r\n3 \u0443\u0440\u043E\u0432\u0435\u043D\u044C:
