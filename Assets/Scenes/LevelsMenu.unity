  m_Script: {fileID: 11500000, guid: 7dca7589529a8e54fa7bef65f0bf6392, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UIHintController
  hoverShow: []
  clickShow: []
  rewriteRotation: 0
  hint: {fileID: 3308186051755512878, guid: deaccf6588755764989cbd8efab72b7f, type: 3}
  hintText:
  - "\u041F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u043D\u044F \u043D\u0430\u0443\u043A\u043E\u0432\u043E-\u0434\u043E\u0441\u043B\u0456\u0434\u043D\u043E\u0433\u043E
    \u0441\u0435\u043A\u0442\u043E\u0440\u0430:\r\n\u041A\u043E\u0436\u0435\u043D
    \u0440\u0456\u0432\u0435\u043D\u044C \u043F\u043E\u043A\u0440\u0430\u0449\u0443\u0454
    \u043E\u0431\u043E\u0440\u043E\u043D\u043D\u0456 \u0441\u043F\u043E\u0440\u0443\u0434\u0438,
    \u0434\u0440\u043E\u043D\u0456\u0432,\r\n\u0430\u043A\u0442\u0438\u0432\u043D\u0456
    \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0442\u0430 \u043C\u0456\u0441\u044C\u043A\u0456
    \u0442\u0443\u0440\u0435\u043B\u0456."
  - 'Research Sector Upgrades:

    Each level improves defensive structures, drones,

    active
    skills, and city turrets.'
  - "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u043D\u0430\u0443\u0447\u043D\u043E-\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E
    \u0441\u0435\u043A\u0442\u043E\u0440\u0430:\r\n\u041A\u0430\u0436\u0434\u044B\u0439
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0442
    \u043E\u0431\u043E\u0440\u043E\u043D\u043D\u044B\u0435 \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F,
    \u0434\u0440\u043E\u043D\u043E\u0432,\r\n\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435
    \u043D\u0430\u0432\u044B\u043A\u0438 \u0438 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0435
    \u0442\u0443\u0440\u0435\u043B\u0438."
