    \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440 \u0431\u0440\u043E\u043D\u0456
    1.1, \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F 1% \u0437\u0430
    \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u0456\u0441\u043B\u044F 10
    \u0441\u0435\u043A\u0443\u043D\u0434 \u0441\u043F\u043E\u043A\u043E\u044E.\r\n2
    \u0440\u0456\u0432\u0435\u043D\u044C: \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440
    \u0431\u0440\u043E\u043D\u0456 1.2, \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
    2% \u0437\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u0456\u0441\u043B\u044F
    10 \u0441\u0435\u043A\u0443\u043D\u0434 \u0441\u043F\u043E\u043A\u043E\u044E.\r\n3
    \u0440\u0456\u0432\u0435\u043D\u044C: \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440
    \u0431\u0440\u043E\u043D\u0456 1.3, \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
    3% \u0437\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u0456\u0441\u043B\u044F
    5 \u0441\u0435\u043A\u0443\u043D\u0434 \u0441\u043F\u043E\u043A\u043E\u044E.\r\n4
    \u0440\u0456\u0432\u0435\u043D\u044C: \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440
    \u0431\u0440\u043E\u043D\u0456 1.4, \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
    4% \u0437\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u0456\u0441\u043B\u044F
    5 \u0441\u0435\u043A\u0443\u043D\u0434 \u0441\u043F\u043E\u043A\u043E\u044E.\r\n5
    \u0440\u0456\u0432\u0435\u043D\u044C: \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440
    \u0431\u0440\u043E\u043D\u0456 1.5, \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
    5% \u0437\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u0456\u0441\u043B\u044F
    2.5 \u0441\u0435\u043A\u0443\u043D\u0434 \u0441\u043F\u043E\u043A\u043E\u044E."
  - 'Residential Sector Upgrade:

    Level 1: Armor modifier 1.1, 1% recovery per
    second after 10 seconds of rest.

    Level 2: Armor modifier 1.2, 2% recovery
    per second after 10 seconds of rest.

    Level 3: Armor modifier 1.3, 3% recovery
    per second after 5 seconds of rest.

    Level 4: Armor modifier 1.4, 4% recovery
    per second after 5 seconds of rest.

    Level 5: Armor modifier 1.5, 5% recovery
    per second after 2.5 seconds of rest.'
  - "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u0436\u0438\u043B\u0438\u0449\u043D\u043E\u0433\u043E
    \u0441\u0435\u043A\u0442\u043E\u0440\u0430:\r\n1 \u0443\u0440\u043E\u0432\u0435\u043D\u044C:
    \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440 \u0431\u0440\u043E\u043D\u0438
    1.1, \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    1% \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u043E\u0441\u043B\u0435
    10 \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u043E\u043A\u043E\u044F.\r\n2
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C: \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440
    \u0431\u0440\u043E\u043D\u0438 1.2, \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    2% \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u043E\u0441\u043B\u0435
    10 \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u043E\u043A\u043E\u044F.\r\n3
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C: \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440
    \u0431\u0440\u043E\u043D\u0438 1.3, \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    3% \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u043E\u0441\u043B\u0435
    5 \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u043E\u043A\u043E\u044F.\r\n4 \u0443\u0440\u043E\u0432\u0435\u043D\u044C:
    \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440 \u0431\u0440\u043E\u043D\u0438
    1.4, \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    4% \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u043E\u0441\u043B\u0435
    5 \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u043E\u043A\u043E\u044F.\r\n5 \u0443\u0440\u043E\u0432\u0435\u043D\u044C:
    \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440 \u0431\u0440\u043E\u043D\u0438
    1.5, \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    5% \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u043E\u0441\u043B\u0435
    2.5 \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u043E\u043A\u043E\u044F."
