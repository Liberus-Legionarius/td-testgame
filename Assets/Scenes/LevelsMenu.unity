  rewriteRotation: 0
  hint: {fileID: 3308186051755512878, guid: deaccf6588755764989cbd8efab72b7f, type: 3}
  hintText:
  - "\u041F\u043E\u043B\u0456\u043F\u0448\u0435\u043D\u043D\u044F \u043C\u0456\u0436\u0433\u0440\u0430\u0434\u043D\u043E\u0457
    \u0456\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0438\r\n1
    \u0440\u0456\u0432\u0435\u043D\u044C: +2.5 \u043C\u043E\u043D\u0435\u0442\u0438
    \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443\r\n2 \u0440\u0456\u0432\u0435\u043D\u044C:
    +5 \u043C\u043E\u043D\u0435\u0442 \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443\r\n3
    \u0440\u0456\u0432\u0435\u043D\u044C: +7.5 \u043C\u043E\u043D\u0435\u0442 \u043D\u0430
    \u0441\u0435\u043A\u0443\u043D\u0434\u0443\r\n4 \u0440\u0456\u0432\u0435\u043D\u044C:
    +10 \u043C\u043E\u043D\u0435\u0442 \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443\r\n5
    \u0440\u0456\u0432\u0435\u043D\u044C: +12.5 \u043C\u043E\u043D\u0435\u0442 \u043D\u0430
    \u0441\u0435\u043A\u0443\u043D\u0434\u0443\r\n\u0411\u043E\u043D\u0443\u0441:
    +25 \u043C\u043E\u043D\u0435\u0442 \u0456\u0437 \u0448\u0430\u043D\u0441\u043E\u043C
    38%, +50 \u043C\u043E\u043D\u0435\u0442 \u0456\u0437 \u0448\u0430\u043D\u0441\u043E\u043C
    12%"
  - 'Improved Intercity Infrastructure

    Level 1: +2.5 coins per second

    Level
    2: +5 coins per second

    Level 3: +7.5 coins per second

    Level 4: +10
    coins per second

    Level 5: +12.5 coins per second

    Bonus: +25 coins with
    a 38% chance, +50 coins with a 12% chance'
  - "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u043C\u0435\u0436\u0433\u0440\u0430\u0434\u043D\u043E\u0439
    \u0438\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B\r\n1
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C: +2.5 \u043C\u043E\u043D\u0435\u0442\u044B
    \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443\r\n2 \u0443\u0440\u043E\u0432\u0435\u043D\u044C:
    +5 \u043C\u043E\u043D\u0435\u0442 \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443\r\n3
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C: +7.5 \u043C\u043E\u043D\u0435\u0442
    \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443\r\n4 \u0443\u0440\u043E\u0432\u0435\u043D\u044C:
    +10 \u043C\u043E\u043D\u0435\u0442 \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443\r\n5
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C: +12.5 \u043C\u043E\u043D\u0435\u0442
    \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443\r\n\u0411\u043E\u043D\u0443\u0441:
    +25 \u043C\u043E\u043D\u0435\u0442 \u0441 \u0448\u0430\u043D\u0441\u043E\u043C
    38% +50 \u043C\u043E\u043D\u0435\u0442 \u0441 \u0448\u0430\u043D\u0441\u043E\u043C
    12%"
