    - target: {fileID: 8312951248025461739, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: m_Resource
      value: 
      objectReference: {fileID: 8300000, guid: b54ad786c663adf40be01139589ccbf9, type: 3}
    - target: {fileID: 8830537307177098256, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: m_Name
      value: UI
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: texts.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: toShow.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[0]'
      value: "\u041C\u0430\u0440\u0448\u0430\u043B, \u0437\u043B\u0456\u0432\u0430
        \u043A\u043E\u043D\u0432\u043E\u0439 \u0442\u0438\u0445, \u0445\u0442\u043E
        \u0432\u0438\u0436\u0438\u0432!\nMarshal, there's a convoy of survivors on
        the left!"
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[1]'
      value: "\u0427\u043E\u0440\u0442, \u0432\u043E\u043D\u0438 \u043D\u0435 \u0437\u043C\u043E\u0436\u0443\u0442\u044C
        \u0437\u0430\u043B\u0456\u0437\u0442\u0438 \u043F\u043E \u0441\u0445\u0438\u043B\u0443.\nDamn,
        they won't be able to climb the slope..."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[2]'
      value: "\u0407\u043C \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
        \u043E\u0431'\u0457\u0445\u0430\u0442\u0438 \u0441\u0445\u0438\u043B, \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044F
        \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0457\u0445\u043D\u0454
        \u0436\u0438\u0442\u0442\u044F.\nThey will have to go around the slope, try
        to save their lives."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[3]'
      value: "\u0414\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u0432\u0430\u043C,
        \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E, \u0441\u0442\u0430\u043D\u0435
        \u0432 \u043D\u0430\u0433\u043E\u0434\u0456 \u043B\u044C\u043E\u0434\u043E\u043C\u0435\u0442
        - \u0432\u0435\u0436\u0430-\u043C\u043E\u0440\u043E\u0437\u0438\u043B\u043A\u0430.\nFor
        this, you will probably need an  snowthrower."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[4]'
      value: "\u0412\u043E\u043D\u0430 \u0443\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u044E\u0454
        \u0456 \u0437\u0440\u0435\u0448\u0442\u043E\u044E \u0437\u0443\u043F\u0438\u043D\u044F\u0454
        \u0432\u043E\u0440\u043E\u0433\u0456\u0432, \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u044E\u044E\u0447\u0438
        \u0457\u0445 \u043D\u0430 \u043B\u0456\u0434, \u044F\u043A\u0438\u0439 \u043C\u043E\u0436\u0443\u0442\u044C
        \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u0442\u0438 \u0456\u043D\u0448\u0456
        \u0437\u043E\u043C\u0431\u0456.\nIt slows and eventually freezes enemies,
        turning them into ice that can be attacked by other zombies."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[5]'
      value: "\u0410\u043B\u0435 \u043D\u0435 \u0437\u0430\u0431\u0443\u0432\u0430\u0439\u0442\u0435
        \u0456 \u043F\u0440\u043E \u0434\u043E\u0440\u043E\u0433\u0443 \u0434\u043E
        \u043C\u0456\u0441\u0442\u0430. \u041F\u0440\u0430\u0432\u043E\u0440\u0443\u0447
        \u043D\u0430\u0441\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F \u043E\u0440\u0434\u0430
        \u0437\u043E\u043C\u0431\u0456, \u0432\u043E\u043D\u0438 \u043C\u0430\u044E\u0442\u044C
        \u0456 \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u0445
        \u0432\u0456\u043A\u0456\u043D\u0433i\u0432, \u0456 \u0442\u043E\u0432\u0441\u0442\u0443\u043D\u0456\u0432,
        \u0456 \u043D\u0430\u0432\u0456\u0442\u044C \u043F\u043B\u0430\u043D\u0435\u0440\u0456\u0432.\nBut
        don't forget about the road to the city. A horde of zombies is approaching
        from the right, including armored Vikings, fatties and even gliders."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[6]'
      value: "\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u043C\u0438
        \u0449\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u043D\u0435\u043C\u043E\u0441\u044F,
        \u041C\u0430\u0440\u0448\u0430\u043B\u0435.\nI hope we meet again, Marshal."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
