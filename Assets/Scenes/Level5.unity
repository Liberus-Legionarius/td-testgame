--- !u!1001 &1681680992
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 425358877213395654, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: m_SizeDelta.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 425358877213395654, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: m_SizeDelta.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: goodbye.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'goodbye.Array.data[0]'
      value: "\u041D\u0435\u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E... \u0412\u0438
        \u0432\u043F\u043E\u0440\u0430\u043B\u0438\u0441\u044F!\nUnbelievable...
        You did it!"
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'goodbye.Array.data[1]'
      value: "\u041A\u043E\u043D\u0432\u043E\u0439 \u0443\u0441\u043F\u0456\u0448\u043D\u043E
        \u0434\u0456\u0441\u0442\u0430\u0432\u0441\u044F \u043C\u0456\u0441\u0442\u0430
        \u0456 \u0432\u0430\u043C \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0432\u0456\u0434\u0431\u0438\u0442\u0438
        \u043B\u044E\u0442\u0438\u0439 \u0443\u0434\u0430\u0440 \u0431\u0435\u0437\u043B\u0456\u0447\u0456
        \u043E\u0440\u0434 \u0437\u043E\u043C\u0431\u0456!\nThe convoy successfully
        reached the city and you managed to repel the furious attack of numerous
        hordes of zombies!"
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'goodbye.Array.data[2]'
      value: "\u0422\u0435\u043F\u0435\u0440 \u043D\u0430\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u0440\u043E\u0437\u043F\u0438\u0442\u0430\u0442\u0438 \u0442\u0438\u0445,
        \u0445\u0442\u043E \u0432\u0438\u0436\u0438\u0432, \u043C\u043E\u0436\u0435,
        \u0443 \u043D\u0438\u0445 \u0454 \u0446\u0456\u043D\u043D\u0430 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F...\nNow
        we need to question the survivors, maybe they have valuable information..."
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'goodbye.Array.data[3]'
      value: "...\u0430\u043B\u0435, \u0432 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
        \u0432\u0438\u043F\u0430\u0434\u043A\u0443, \u0457\u0445 \u0436\u0438\u0442\u0442\u044F
        \u0432 \u0431\u0435\u0437\u043F\u0435\u0446\u0456, \u0456 \u0432\u0441\u0435
        \u0437\u0430\u0432\u0434\u044F\u043A\u0438 \u0432\u0430\u043C!\n...but, in
        any case, their lives are safe, and all thanks to you!"
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: goodbyeShow.Array.size
      value: 4
      objectReference: {fileID: 0}
