    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: goodbye.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'goodbye.Array.data[0]'
      value: "\u041C\u0430\u0440\u0448\u0430\u043B, \u0442\u0435\u0440\u043C\u0456\u043D\u043E\u0432\u043E
        \u0432\u043C\u0438\u043A\u0430\u0439\u0442\u0435 \u041C\u0456\u0441\u0442\u043E
        5!\nMarshal, turn on City 5 immediately!"
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'goodbye.Array.data[1]'
      value: "\u041D\u0443, \u0440\u0456\u0432\u0435\u043D\u044C 5, \u044F\u043A
        \u0431\u0438 \u0432\u0438 \u0439\u043E\u0433\u043E \u043D\u0430\u0437\u0432\u0430\u043B\u0438.\nWell,
        level 5, as you would call it."
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'goodbye.Array.data[2]'
      value: "\u0412\u043E\u043D\u0438 \u0431'\u044E\u0442\u044C \u043D\u0430 \u0441\u043F\u043E\u043B\u043E\u0445,
        \u043D\u0430 \u043D\u0438\u0445 \u0440\u0443\u0445\u0430\u0454\u0442\u044C\u0441\u044F
        \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u0439 \u043D\u0430\u0442\u043E\u0432\u043F
        \u0437\u043E\u043C\u0431\u0456 \u0456, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
        \u0457\u0445\u043D\u044F \u043C\u0435\u0442\u0430 - \u043A\u043E\u043D\u0432\u043E\u0439
        \u0442\u0438\u0445, \u0445\u0442\u043E \u0432\u0438\u0436\u0438\u0432!\nThey
        sound the alarm, a huge crowd of zombies is moving towards them and it seems
        their target is a convoy of survivors!"
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: goodbyeShow.Array.size
