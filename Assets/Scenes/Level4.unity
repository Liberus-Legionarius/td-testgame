    - target: {fileID: 8830537307177098256, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: m_Name
      value: UI
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: texts.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: toShow.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: hidenUI.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[0]'
      value: "\u0421\u0438\u043D\u043E\u043F\u0442\u0438\u043A\u0438 \u043E\u0431\u0456\u0446\u044F\u044E\u0442\u044C
        \u043D\u0435\u0437\u043D\u0430\u0447\u043D\u0456 \u043E\u043F\u0430\u0434\u0438
        \u0443 \u0432\u0438\u0433\u043B\u044F\u0434\u0456...\nForecasters are predicting
        light precipitation in the form of..."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[1]'
      value: "...\u0432\u0438\u0431\u0443\u0445\u043E\u0432\u0438\u0445 \u0437\u043E\u043C\u0431\u0456...\n...explosive
        zombies..."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[2]'
      value: "\u041A\u0445\u043C... \u041D\u0430\u0432\u0456\u0449\u043E \u044F \u0446\u0435...\nHmm...
        Why am I saying this..."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[3]'
      value: "\u041C\u0430\u0440\u0448\u0430\u043B\u0435, \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456
        \u043D\u0430 \u043D\u0430\u0441 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0438
        \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u0440\u0435\u0439\u0434
        \u0437\u043E\u043C\u0431\u0456-\u043F\u043B\u0430\u043D\u0435\u0440\u0438.\nMarshal,
        zombie gliders have decided to raid us today."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[4]'
      value: "\u0407\u0445 \u0432\u0456\u0434\u0440\u0456\u0437\u043D\u044F\u0454
        \u0432\u0456\u0434 \u0456\u043D\u0448\u0438\u0445 \u0442\u0435, \u0449\u043E
        \u0432\u043E\u043D\u0438 \u043B\u0456\u0442\u0430\u044E\u0442\u044C, \u0432\u043B\u0430\u0448\u0442\u043E\u0432\u0443\u044E\u0442\u044C
        \u043A\u0430\u043C\u0456\u043A\u0430\u0434\u0437\u0435-\u0430\u0442\u0430\u043A\u0443
        \u043D\u0430 \u043C\u0456\u0441\u0442\u043E \u0456 \u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u043D\u043E
        \u043F\u043E\u043C\u0438\u0440\u0430\u044E\u0442\u044C, \u0437\u0430\u043B\u0438\u0448\u0430\u044E\u0447\u0438
        \u043D\u0430\u0441 \u0443 \u0440\u0443\u0457\u043D\u0430\u0445.\nWhat distinguishes
        them from others is that they fly, carry out a kamikaze attack on a city
        and die happily, leaving us in ruins."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[5]'
      value: "\u042F\u043A\u0449\u043E \u0445\u043E\u0447\u0435\u0442\u0435 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
        \u0431\u0456\u043B\u044C\u0448\u0435 \u043E\u0447\u043E\u043A \u0434\u043E\u0441\u0432\u0456\u0434\u0443
        (\u0456 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043D\u0430\u0448\u0456
        \u0436\u0438\u0442\u0442\u044F), \u043D\u0435 \u043F\u0456\u0434\u043F\u0443\u0441\u043A\u0430\u0439\u0442\u0435
        \u043B\u0456\u0442\u0430\u044E\u0447\u0438\u0445 \u0437\u043E\u043C\u0431\u0456
        \u0434\u043E \u043C\u0456\u0441\u0442\u0430.\nIf you want to get more experience
        points (and save our lives), don't let the flying zombies get near the city."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[6]'
      value: "\u0410\u043B\u0435!\nBut!"
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[7]'
      value: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0456 \u0432\u0435\u0436\u0456
        \u043D\u0435 \u043C\u043E\u0436\u0443\u0442\u044C \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u0442\u0438
        \u043B\u0456\u0442\u0430\u044E\u0447\u0438\u0445 \u0437\u043E\u043C\u0431\u0456,
        \u043D\u0430 \u0446\u0435 \u0437\u0434\u0430\u0442\u043D\u0456 \u043B\u0438\u0448\u0435
        \u0437\u0435\u043D\u0456\u0442\u043D\u0456 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
        \u0442\u0430 \u0442\u0443\u0440\u0435\u043B\u0456.\nRegular towers cannot
        attack flying zombies; only anti-aircraft guns and turrets can do this."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[8]'
      value: "\u041C\u043E\u044F \u0432\u0430\u043C \u043F\u043E\u0440\u0430\u0434\u0430:
        \u043F\u043E\u0441\u0442\u0430\u0432\u0442\u0435 \u0440\u0430\u0437\u0443
        \u043F\u0430\u0440\u0443-\u0442\u0440\u0456\u0439\u043A\u0443 \u0437\u0435\u043D\u0456\u0442\u043E\u043A
        \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u043C\u0456\u0441\u0442\u0430.\nMy
        advice to you: place a couple of anti-aircraft guns around the city."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
