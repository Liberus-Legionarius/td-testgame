      objectReference: {fileID: 8300000, guid: a9b43024e76aaee4fa3b50d943dfdb80, type: 3}
    - target: {fileID: 8830537307177098256, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: m_Name
      value: UI
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: output
      value: 
      objectReference: {fileID: 488015655}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: texts.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: toShow.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[0]'
      value: "\u0417\u043D\u043E\u0432\u0443 \u0432\u0456\u0442\u0430\u044E \u0432\u0430\u0441,
        \u041C\u0430\u0440\u0448\u0430\u043B\u0435.\nWelcome again, Marshal."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[1]'
      value: "\u0417\u043E\u043C\u0431\u0456 \u0437\u043D\u043E\u0432\u0443 \u0445\u043E\u0447\u0443\u0442\u044C
        \u0437\u0440\u0443\u0439\u043D\u0443\u0432\u0430\u0442\u0438 \u043D\u0430\u0448\u0435
        \u043C\u0456\u0441\u0442\u043E \u0442\u0430 \u0437'\u0457\u0441\u0442\u0438
        \u043D\u0430\u0448\u0456 \u043C\u0456\u0437\u043A\u0438.\nZombies want to
        destroy our city and eat our brains again."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[2]'
      value: "\u0410\u043B\u0435 \u0454 \u0439 \u0434\u043E\u0431\u0440\u0456 \u043D\u043E\u0432\u0438\u043D\u0438!\nBut
        there is good news too!"
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[3]'
      value: "\u041D\u0430 \u0446\u0435\u0439 \u0440\u0430\u0437 \u043D\u0430\u0448\u0456
        \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u0438 \u0432\u0438\u043D\u0430\u0439\u0448\u043B\u0438
        \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u043F\u0440\u0430\u0446\u044E\u044E\u0447\u0438\u0439
        \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442!\nThis time
        our engineers have invented a fully functioning grenade launcher!"
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[4]'
      value: "\u0419\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u0430 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438
        \u0434\u0440\u0443\u0433\u0438\u043C \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0456
        \u0437\u0431\u0440\u043E\u0457.\nYou can see it second on the weapon panel."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[5]'
      value: "\u0420\u0430\u0434\u0436\u0443 \u0432\u0430\u043C \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
        \u0439\u043E\u0433\u043E \u0434\u043B\u044F \u0437\u043D\u0438\u0449\u0435\u043D\u043D\u044F
        \u0442\u0430\u043A \u0437\u0432\u0430\u043D\u0438\u0445 \"\u0436\u0438\u0440\u043D\u0438\u0445
        \u0437\u043E\u043C\u0431\u0456\", \u0430\u0434\u0436\u0435 \u0432\u043E\u043D\u0438
        \u0434\u043E\u0441\u0438\u0442\u044C \u0442\u043E\u0432\u0441\u0442\u043E\u0448\u043A\u0456\u0440\u0456,
        \u043F\u0440\u043E\u0441\u0442\u0438\u0439 \u043A\u0443\u043B\u0435\u043C\u0435\u0442
        \u0437\u0430\u0432\u0434\u0430\u0441\u0442\u044C \u0457\u043C \u043D\u0435
        \u0442\u0430\u043A\u043E\u0457 \u0437\u043D\u0430\u0447\u043D\u043E\u0457
        \u0448\u043A\u043E\u0434\u0438.\nI advise you to use it to destroy the so-called
        \"fat zombies\", because they are quite thick-skinned, a simple machine gun
        will not cause them much harm."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects:
    - {fileID: 901452981430976381, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
    m_AddedGameObjects: []
