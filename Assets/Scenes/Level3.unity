      objectReference: {fileID: 8300000, guid: 39e4bea4e3fb5534bac7036cc9fb7952, type: 3}
    - target: {fileID: 8830537307177098256, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: m_Name
      value: UI
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: texts.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: toShow.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[0]'
      value: "\u0414\u043E\u0431\u0440\u043E\u0457 \u043D\u043E\u0447\u0456, \u041C\u0430\u0440\u0448\u0430\u043B\u0435.\nGood
        night, Marshal.."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[1]'
      value: "\u0414\u0435\u044F\u043A\u0456 \u0437\u043E\u043C\u0431\u0456 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
        \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456 \u0432\u043D\u043E\u0447\u0456...
        \u041D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u0437\u043E\u043C\u0431\u0456-\u0432\u0430\u043C\u043F\u0456\u0440\u0438.\nSome
        zombies are especially dangerous at night... For example, zombie vampires."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[2]'
      value: "\u0412\u0434\u0435\u043D\u044C \u0432\u043E\u043D\u0438 \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u0432\u043E
        \u0432\u043C\u0438\u0440\u0430\u044E\u0442\u044C \u0432\u0456\u0434 \u0441\u043E\u043D\u044F\u0447\u043D\u0438\u0445
        \u043F\u0440\u043E\u043C\u0435\u043D\u0456\u0432, \u0430\u043B\u0435 \u0432\u043D\u043E\u0447\u0456
        \u0432\u043E\u043D\u0438 \u0441\u0442\u0430\u044E\u0442\u044C \u043D\u0430\u0448\u043E\u044E
        \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u044E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u044E,
        \u0430\u0434\u0436\u0435 \u0432\u043E\u043D\u0438 \u0448\u0432\u0438\u0434\u0448\u0435
        \u0456 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0456 \u0437\u0430 \u043F\u0440\u043E\u0441\u0442\u0456
        \u0437\u043E\u043C\u0431\u0456, \u0445\u0430\u0439 \u0456 \u043D\u0435 \u0441\u0438\u043B\u044C\u043D\u043E
        \u043C\u0456\u0446\u043D\u0456.\nDuring the day they gradually die from the
        sun's rays, but at night they become our main problem, because they are faster
        and stronger than ordinary zombies, although not very strong."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[3]'
      value: "\u0429\u043E\u0431 \u043B\u0456\u043A\u0432\u0456\u0434\u0443\u0432\u0430\u0442\u0438
        \u0442\u0430\u043A\u0438\u0445 \u043D\u0435\u043F\u0440\u0438\u0454\u043C\u043D\u0438\u0445
        \u0437\u043E\u043C\u0431\u0456 \"\u0437 \u043F\u043B\u043E\u0442\u0456 \u0442\u0430
        \u043A\u0440\u043E\u0432\u0456\" \u043D\u0430\u0448\u0456 \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u0438
        \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E\u0442\u044C
        \u0432\u0430\u043C \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
        \u0432\u043E\u0433\u043D\u0435\u043C\u0435\u0442.\nTo eliminate these nasty
        flesh-and-blood zombies, our engineers recommend using a flamethrower."
      objectReference: {fileID: 0}
    - target: {fileID: 8955561636746001231, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'texts.Array.data[4]'
      value: "\u0412\u043E\u0433\u043D\u0435\u043C\u0435\u0442 \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
        \u0442\u0440\u0435\u0442\u0456\u043C \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0456
        \u0432\u0435\u0436. \u0423\u0441\u043F\u0456\u0445\u0456\u0432!\nThe flamethrower
        is third on the turret panel. Good luck!"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
