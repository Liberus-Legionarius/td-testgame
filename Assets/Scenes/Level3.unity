--- !u!1001 &1557884972
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 425358877213395654, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: m_SizeDelta.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 425358877213395654, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: m_SizeDelta.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: goodbye.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'goodbye.Array.data[0]'
      value: "\u0425\u0430\u0445...\nHuh...\n\u0425\u0430\u0445..."
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'goodbye.Array.data[1]'
      value: "\u0421\u043F\u0435\u043A\u043E\u0442\u043D\u0430 \u0432\u0438\u0434\u0430\u043B\u0430\u0441\u044F
        \u043D\u0456\u0447...\nIt was a hot night...\n\u0416\u0430\u0440\u043A\u0430\u044F
        \u0432\u044B\u0434\u0430\u043B\u0430\u0441\u044C \u043D\u043E\u0447\u044C..."
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'goodbye.Array.data[2]'
      value: "\u0406 \u0449\u0435 \u043E\u0434\u043D\u0430 \u043F\u043E\u0440\u0430\u0434\u0430.
        \u042F\u043A\u043E\u0441\u044C \u0432\u0438 \u043C\u0435\u043D\u0456 \u043A\u0430\u0437\u0430\u043B\u0438,
        \u0449\u043E \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u043E\u044E
        \u0434\u0443\u0440\u0456\u0441\u0442\u044E \u0454 \u0441\u043F\u0440\u043E\u0431\u0430
        \u0432\u0431\u0438\u0442\u0438 \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u043E\u0433\u043E
        \u0437\u043E\u043C\u0431\u0456 \u0432\u043E\u0433\u043D\u0435\u043C.\nAnd
        one more piece of advice. You once told me that the greatest folly is trying
        to kill an armored zombie with fire.\n\u0418 \u0435\u0449\u0451 \u043E\u0434\u0438\u043D
        \u0441\u043E\u0432\u0435\u0442. \u0412\u044B \u043A\u0430\u043A-\u0442\u043E
        \u0440\u0430\u0437 \u043C\u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438,
        \u0447\u0442\u043E \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0435\u0439
        \u0433\u043B\u0443\u043F\u043E\u0441\u0442\u044C\u044E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
        \u043F\u043E\u043F\u044B\u0442\u043A\u0430 \u0443\u0431\u0438\u0442\u044C
        \u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
        \u0437\u043E\u043C\u0431\u0438 \u043E\u0433\u043D\u0451\u043C. "
      objectReference: {fileID: 0}
    - target: {fileID: 1863225949964665893, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: 'goodbye.Array.data[3]'
      value: "\u042F\u043A\u0449\u043E \u0431\u0430\u0447\u0438\u0442\u0435 \u0431\u0430\u0433\u0430\u0442\u043E
        \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u0445 \u0432\u043E\u0440\u043E\u0433\u0456\u0432,
        \u043F\u0440\u043E\u0448\u0443 \u043D\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
        \u0432\u043E\u0433\u043D\u0435\u043C\u0435\u0442.\nIf you see a lot of armored
        enemies, please do not use the flamethrower.\n\u0415\u0441\u043B\u0438 \u0432\u0438\u0434\u0438\u0442\u0435
        \u043C\u043D\u043E\u0433\u043E \u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
        \u0432\u0440\u0430\u0433\u043E\u0432, \u043F\u0440\u043E\u0448\u0443, \u043D\u0435
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043E\u0433\u043D\u0435\u043C\u0451\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 5400878903853282809, guid: 4f066faa1ee9db3438ebb2748ca876fe, type: 3}
      propertyPath: m_Pivot.x
